# 미래에셋증권 OpenAPI 키 (있을 경우. 없으면 무료 폴백 자동 사용)
MIRAE_APP_KEY=
MIRAE_APP_SECRET=

# 내 포트폴리오 페이지 로그인 비밀번호
PORTFOLIO_PASSWORD=

# 포트폴리오 영구 저장용 Supabase Postgres 접속 URL
# 미설정 시 로컬 SQLite로 폴백 (Streamlit Cloud에서는 재시작 시 데이터 유실)
# Supabase Connect → 풀러 연결 문자열. 드라이버는 psycopg2.
#   - Session 풀러(5432): 로컬·웹 모두 동작 (일부 사내/가정망이 6543을 막으므로 5432 권장)
#   - Transaction 풀러(6543): Streamlit Cloud 전용으로 적합
# 예) postgresql+psycopg2://postgres.<프로젝트ref>:<비밀번호>@aws-0-<리전>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=
